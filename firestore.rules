rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        (
          // Keep support for a server-issued custom admin claim.
          request.auth.token.admin == true ||
          // GitHub account ID for github.com/tarudesu.
          (
            request.auth.token.firebase.sign_in_provider == 'github.com' &&
            request.auth.token.firebase.identities['github.com'].hasAny([
              '76896906',
              'github.com:76896906'
            ])
          )
        );
    }

    match /conferences/{conference} {
      // Allow anyone to read the conferences
      allow read: if true;
      
      // Firebase's GitHub `name` claim is the profile display name, not the
      // unique GitHub username. Use the provider identity ID instead.
      allow create, update, delete: if isAdmin();
    }
  }
}
